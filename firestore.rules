rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Properties are readable by anyone, writable by authenticated users (creators only)
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.agentUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.agentUid == request.auth.uid;
    }
    
    // Market News: readable by anyone, writeable only via Admin SDK
    match /market_news/{docId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Chats: readable and writable by participants
    match /chats/{chatId} {
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
    
    // Alerts (FREE & PRO)
    match /alerts/{alertId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Notifications (FREE & PRO)
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Favorites
    match /favorites/{favoriteId} {
      allow read, write: if false; // Favorites are stored directly in user profiles
    }

    // Users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'userType', 'role']));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── BROKER PRO ──
    match /broker_alerts/{alertId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /broker_notifications/{notifId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /broker_leads/{leadId} {
      allow read, update, delete: if request.auth != null && resource.data.brokerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.brokerId == request.auth.uid;
    }

    match /crm_leads/{leadId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
