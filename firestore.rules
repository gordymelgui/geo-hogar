rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Properties are readable by anyone, writable by authenticated users (creators only)
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource == null || resource.data.agentUid == request.auth.uid);
    }
    
    // Market News: readable by anyone (used for Analytics)
    match /market_news/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Chats: readable and writable by authenticated users
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Alerts (FREE & PRO)
    match /alerts/{alertId} {
      allow read, write: if request.auth != null;
    }
    
    // Notifications (FREE & PRO)
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    // Favorites
    match /favorites/{favoriteId} {
      allow read, write: if request.auth != null;
    }

    // Users
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // ── BROKER PRO ──
    match /broker_alerts/{alertId} {
      allow read, write: if request.auth != null;
    }

    match /broker_notifications/{notifId} {
      allow read, write: if request.auth != null;
    }

    match /broker_leads/{leadId} {
      allow read, write: if request.auth != null;
    }

    match /crm_leads/{leadId} {
      allow read, write: if request.auth != null;
    }
  }
}
